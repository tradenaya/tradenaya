# JobDraft server — copy to server/.env and fill in. Never commit server/.env.
NODE_ENV=development
PORT=5055
# Where the web client runs (CORS + redirects after Google sign-in)
CLIENT_URL=http://localhost:3055
# Set to false only if you serve production over plain http (not recommended)
# COOKIE_SECURE=true

# MySQL — JobDraft creates DB_NAME (and jobdraft_test for tests) by itself
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=jobdraft

# Generated automatically on first start if empty (32-byte key = 64 hex chars)
JWT_SECRET=
ENCRYPTION_KEY=

# Cloudinary (private resume storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini — models are tried in order, falling back on errors
GEMINI_API_KEY=
GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest,gemini-3.8-flash,gemini-3.5-flash-lite
# GEMINI_DELAY_MS=1500

# Google OAuth (Gmail drafts). Must exactly match the redirect URI in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5055/api/gmail/callback

# Job sources
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Adzuna calls per day across all users (free plan: 250/day)
# ADZUNA_DAILY_CAP=230
# JSearch on RapidAPI (optional; free plan: 200 searches a month). Shared by every user
# without their own key; users can add their own free key on Setup.
RAPIDAPI_KEY=
# The shared key's monthly searches and the day of the month they reset (the day you subscribed).
# Each day may use what is left divided by the days left; that day's searches are split
# equally between active users with automation on.
# JSEARCH_MONTHLY_QUOTA=200
# JSEARCH_RESET_DAY=1
# Monthly searches on a user's own key (free plan: 200)
# JSEARCH_OWN_KEY_MONTHLY_QUOTA=200
# Optional extra limits: shared searches per day across all users, searches per run (0 = none)
# JSEARCH_DAILY_CAP=0
# JSEARCH_MAX_CALLS_PER_RUN=0

# true = simulate Gemini, Gmail, Cloudinary and job APIs (demo/testing, no keys needed)
MOCK_EXTERNAL=false

# Sign-ups wait for admin approval (default true; the admin page can switch it)
# SIGNUP_APPROVAL=true
# Google Cloud project id for the admin page link to the OAuth test users (defaults to the number in GOOGLE_CLIENT_ID)
# GOOGLE_CLOUD_PROJECT=

# Optional tuning
# SCHEDULER_ENABLED=true
# MANUAL_RUN_COOLDOWN_MIN=30
# AUTH_RATE_LIMIT_MAX=20
# debug = also log every scheduler minute (users due, blocked, waiting)
# LOG_LEVEL=info